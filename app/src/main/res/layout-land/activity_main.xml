<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <ImageView
        android:id="@+id/topImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/peacock"
        app:layout_constraintTop_toBottomOf="@id/tvRoundslabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="@id/tvRounds"/>

    <ImageView
        android:id="@+id/bottomImageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/peacock"
        app:layout_constraintTop_toBottomOf="@id/tvRoundslabel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@id/rvMantras"
        app:layout_constraintRight_toRightOf="parent" />

    <ImageButton
        android:id="@+id/overflowMenuButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_more_vert_24"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tvRoundslabel"
        app:layout_constraintWidth_percent="0.1"/>

    <TextView
        android:id="@+id/tvRoundslabel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/rvRoundLogLabel"
        app:layout_constraintWidth_percent=".5"
        android:background="@color/material_on_surface_stroke"
        android:text="Rounds"
        android:gravity="center"
        android:textSize="18sp"
        android:paddingBottom="6sp"/>

    <TextView
        android:id="@+id/tvRounds"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvRoundslabel"
        app:layout_constraintLeft_toLeftOf="@id/tvRoundslabel"
        app:layout_constraintRight_toRightOf="@id/tvRoundslabel"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textAlignment="center"
        android:textSize="120sp"
        android:clickable="true"
        android:longClickable="true"
        android:focusable="true"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="50sp"
        android:autoSizeMaxTextSize="160sp"
        android:autoSizeStepGranularity="2sp"/>

    <TextView
        android:id="@+id/rvRoundLogLabel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintHeight_percent=".1"
        app:layout_constraintWidth_percent=".2"
        android:paddingBottom="6dp"/>


    <!-- Log RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRounds"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="150dp"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/rvRoundLogLabel"
        app:layout_constraintLeft_toLeftOf="@id/rvRoundLogLabel"
        app:layout_constraintRight_toRightOf="@id/rvRoundLogLabel"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tvMantraslabel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/tvRoundslabel"
        app:layout_constraintBottom_toBottomOf="@id/rvRoundLogLabel"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@color/material_on_surface_stroke"
        android:text="Mantras"
        android:gravity="center"
        android:textSize="18sp"/>

    <TextView
        android:id="@+id/tvMantras"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintLeft_toLeftOf="@id/tvMantraslabel"
        app:layout_constraintTop_toBottomOf="@id/tvMantraslabel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clickable="true"
        android:longClickable="true"
        android:focusable="true"
        android:textAlignment="center"
        android:textSize="120sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="50sp"
        android:autoSizeMaxTextSize="160sp"
        android:autoSizeStepGranularity="2sp"/>
    <TextView
        android:id="@+id/rvMantraLogLabel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toRightOf="@id/tvRoundslabel"
        app:layout_constraintBottom_toBottomOf="@id/tvRoundslabel"
        app:layout_constraintWidth_percent=".2"/>

    <!-- Log RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMantras"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="150dp"
        android:padding="10dp"
        app:layout_constraintLeft_toLeftOf="@id/rvMantraLogLabel"
        app:layout_constraintRight_toRightOf="@id/rvMantraLogLabel"
        app:layout_constraintTop_toBottomOf="@id/rvMantraLogLabel"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_gravity="end"/>

</androidx.constraintlayout.widget.ConstraintLayout>